# ── Sunucu ───────────────────────────────────────────────────────
PORT=3000
# HOST=0.0.0.0

# ── Spotify (opsiyonel ama önerilir) ─────────────────────────────
# https://developer.spotify.com/dashboard → Create app → Client ID/Secret
# Arama + 640px kapaklar + canvas için track id buradan gelir.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opsiyonel: kullanıcı adına access token (refresh_token akışı).
# Client credentials'a göre bazı uç noktalarda (canvas) daha şanslı.
SPOTIFY_REFRESH_TOKEN=

# Canvas'ın TÜM şarkılarda çalışması için: tarayıcıda open.spotify.com'a
# giriş yap → DevTools → Application → Cookies → `sp_dc` değerini buraya yapıştır.
SPOTIFY_SP_DC=

# ── MP3 çözümleme ────────────────────────────────────────────────
# Virgülle ayrılmış RapidAPI anahtarları (boş bırakılırsa uygulamadaki 3 anahtar kullanılır)
# RAPIDAPI_KEYS=key1,key2,key3
# RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com

# MP3 API (mp3-apisi.onrender.com)
# MP3_API_KEY=sk-...
# MP3_API_BASE=https://mp3-apisi.onrender.com

# ── Flutter web derlemesi ────────────────────────────────────────
# Varsayılan: ../build/web   (flutter build web çıktısı)
# WEB_DIR=/app/build/web
